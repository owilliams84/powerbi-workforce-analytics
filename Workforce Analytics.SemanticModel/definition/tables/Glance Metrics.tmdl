/// Measures behind the landing page, At a glance. Generated by etl/glance_model.py - edit that, not this.
table 'Glance Metrics'
	lineageTag: 2cad8140-4138-5537-bffd-62a534392929

	/// Mean performance rating, 1 to 5, of the people employed at the last month-end in view.
	measure 'Glance Rating' =
			VAR S = [Snapshot Date]
			RETURN
			    AVERAGEX(CALCULATETABLE('Headcount', 'Date'[Date] = S), RELATED('Employee'[Rating]))
		formatString: 0.00
		lineageTag: 55d959bf-7f2d-5db7-b390-c5499289a1f2

	/// The paragraph under the page title.
	measure 'Glance Standfirst' =
			VAR Y = [YoY Year]
			VAR H = [Headcount] + 0
			RETURN
			    IF(H = 0, "Nobody in this selection was employed at the end of " & FORMAT(DATE(2000, [YoY Last Month], 1), "mmm") & " " & Y & ".",
			        FORMAT(H, "#,0") & IF(H = 1, " person", " people") & " at the end of " & FORMAT(DATE(2000, [YoY Last Month], 1), "mmm") & " " & Y
			        & ". Counts are read at the year's last month-end; hires and turnover cover " & [YoY Span]
			        & IF([YoY Comparison Available], " and compare with the same months of " & (Y - 1) & ".",
			             ". " & (Y - 1) & " has no figures for those months to compare with."))
		lineageTag: ce9c2fbe-6ba9-58fa-862e-663b9ad77d8a

	/// KPI tile: headcount at the window's end against the same month-end a year before.
	measure 'Glance Tile Headcount' =
			VAR Y = [YoY Year]
			VAR A = [YoY Headcount] + 0
			VAR B = [YoY Headcount Comparison] + 0
			VAR HasComparison = [YoY Comparison Available] && B > 0
			VAR P = DIVIDE(A - B, B)
			VAR Svg =
			"<svg xmlns='http://www.w3.org/2000/svg' width='235' height='104' viewBox='0 0 235 104' font-family='Segoe UI, sans-serif'><rect x='0.5' y='0.5' width='234' height='103' rx='4' fill='#FFFFFF' stroke='#E3E7EF'/><rect width='3' height='104' fill='#C9A227'/><g transform='translate(16 32) scale(0.8333)'><g fill='none' stroke-width='2.8' stroke-linecap='round' stroke-linejoin='round'><g stroke='#111F38'><circle cx='24' cy='15' r='6.5'/><path d='M13.0 40c0-13 22-13 22 0'/></g><g stroke='#C9A227'><circle cx='9' cy='20' r='4.5'/><path d='M2.0 38c0-9 14-9 14 0'/><circle cx='39' cy='20' r='4.5'/><path d='M32.0 38c0-9 14-9 14 0'/></g></g></g>"
			& "<text x='70' y='25' font-size='10.5' font-weight='700' fill='#667284'>" & "HEADCOUNT, END " & UPPER(FORMAT(DATE(2000, [YoY Last Month], 1), "mmm")) & " " & Y & "</text>"
			& "<text x='70' y='60' font-size='27' font-weight='700' fill='#0A0917'>" & FORMAT(A, "#,0") & "</text>"
			& IF(HasComparison, "<path d='" & IF(P >= 0, "M70 87l4.5-8 4.5 8z", "M70 79l4.5 8 4.5-8z") & "' fill='" & IF(P >= 0, "#1E7A4C", "#B3261E") & "'/>", "")
			& "<text x='" & IF(HasComparison, 84, 70) & "' y='87' font-size='11.5' fill='#667284'>" & IF(HasComparison, FORMAT(ABS(P), "0.0%") & " on " & FORMAT(DATE(2000, [YoY Last Month], 1), "mmm") & " " & (Y - 1) & " (" & FORMAT(B, "#,0") & ")", "no earlier year to compare with") & "</text>"
			& "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(Svg, "%", "%25"), "#", "%23")
		dataCategory: ImageUrl
		lineageTag: d1b110ef-3ad0-5db4-a21c-28866add7176

	/// KPI tile: joiners in the window against the same months a year before.
	measure 'Glance Tile Hires' =
			VAR Y = [YoY Year]
			VAR A = [YoY Joiners] + 0
			VAR B = [YoY Joiners Comparison] + 0
			VAR HasComparison = [YoY Comparison Available] && B > 0
			VAR P = DIVIDE(A - B, B)
			VAR Svg =
			"<svg xmlns='http://www.w3.org/2000/svg' width='235' height='104' viewBox='0 0 235 104' font-family='Segoe UI, sans-serif'><rect x='0.5' y='0.5' width='234' height='103' rx='4' fill='#FFFFFF' stroke='#E3E7EF'/><rect width='3' height='104' fill='#C9A227'/><g transform='translate(16 32) scale(0.8333)'><g fill='none' stroke-width='2.8' stroke-linecap='round' stroke-linejoin='round'><g stroke='#111F38'><circle cx='19' cy='15' r='7'/><path d='M6.0 41c0-15 26-15 26 0'/></g><g stroke='#C9A227'><path d='M38 8v14M31 15h14'/></g></g></g>"
			& "<text x='70' y='25' font-size='10.5' font-weight='700' fill='#667284'>" & "NEW HIRES, " & UPPER([YoY Span]) & "</text>"
			& "<text x='70' y='60' font-size='27' font-weight='700' fill='#0A0917'>" & FORMAT(A, "#,0") & "</text>"
			& IF(HasComparison, "<path d='" & IF(P >= 0, "M70 87l4.5-8 4.5 8z", "M70 79l4.5 8 4.5-8z") & "' fill='" & IF(P >= 0, "#1E7A4C", "#B3261E") & "'/>", "")
			& "<text x='" & IF(HasComparison, 84, 70) & "' y='87' font-size='11.5' fill='#667284'>" & IF(HasComparison, FORMAT(ABS(P), "0.0%") & " on " & (Y - 1) & " (" & FORMAT(B, "#,0") & ")", "no earlier year to compare with") & "</text>"
			& "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(Svg, "%", "%25"), "#", "%23")
		dataCategory: ImageUrl
		lineageTag: 06658cec-0eb5-5a82-90a7-0a353a49029e

	/// KPI tile: annualised turnover over the window. A rise is bad, so it is the red one.
	measure 'Glance Tile Turnover' =
			VAR Y = [YoY Year]
			VAR A = [YoY Turnover]
			VAR B = [YoY Turnover Comparison]
			VAR HasComparison = [YoY Comparison Available] && NOT ISBLANK(B)
			VAR Moved = (A - B) * 100
			VAR Svg =
			"<svg xmlns='http://www.w3.org/2000/svg' width='235' height='104' viewBox='0 0 235 104' font-family='Segoe UI, sans-serif'><rect x='0.5' y='0.5' width='234' height='103' rx='4' fill='#FFFFFF' stroke='#E3E7EF'/><rect width='3' height='104' fill='#C9A227'/><g transform='translate(16 32) scale(0.8333)'><g fill='none' stroke-width='2.8' stroke-linecap='round' stroke-linejoin='round'><g stroke='#111F38'><path d='M26 6H8v36h18'/><circle cx='20' cy='24' r='1.6'/></g><g stroke='#C9A227'><path d='M22 24h20M35 17l7 7-7 7'/></g></g></g>"
			& "<text x='70' y='25' font-size='10.5' font-weight='700' fill='#667284'>" & "TURNOVER, ANNUALISED" & "</text>"
			& "<text x='70' y='60' font-size='27' font-weight='700' fill='#0A0917'>" & IF(ISBLANK(A), "n/a", FORMAT(A, "0.0%")) & "</text>"
			& IF(HasComparison, "<path d='" & IF(Moved > 0, "M70 87l4.5-8 4.5 8z", "M70 79l4.5 8 4.5-8z") & "' fill='" & IF(Moved > 0, "#B3261E", "#1E7A4C") & "'/>", "")
			& "<text x='" & IF(HasComparison, 84, 70) & "' y='87' font-size='11.5' fill='#667284'>" & IF(HasComparison, FORMAT(ABS(Moved), "0.0") & "pp on " & (Y - 1) & " (" & FORMAT(B, "0.0%") & ")", "no earlier year to compare with") & "</text>"
			& "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(Svg, "%", "%25"), "#", "%23")
		dataCategory: ImageUrl
		lineageTag: b4c2cc30-4fa8-5beb-994e-b5cf9f935eb6

	/// KPI tile: mean engagement from surveys answered while employed. The survey ran from
	/// October 2022, so earlier years have none.
	measure 'Glance Tile Engagement' =
			VAR Y = [YoY Year]
			VAR A = [Engagement Score]
			VAR N = [Surveys] + 0
			VAR Svg =
			"<svg xmlns='http://www.w3.org/2000/svg' width='235' height='104' viewBox='0 0 235 104' font-family='Segoe UI, sans-serif'><rect x='0.5' y='0.5' width='234' height='103' rx='4' fill='#FFFFFF' stroke='#E3E7EF'/><rect width='3' height='104' fill='#C9A227'/><g transform='translate(16 32) scale(0.8333)'><g fill='none' stroke-width='2.8' stroke-linecap='round' stroke-linejoin='round'><g stroke='#111F38'><path d='M24 41S6 30 6 18a9.5 9.5 0 0 1 18-4 9.5 9.5 0 0 1 18 4c0 12-18 23-18 23z'/></g><g stroke='#C9A227'><path d='M13 24h6l3-6 5 11 3-5h5'/></g></g></g>"
			& "<text x='70' y='25' font-size='10.5' font-weight='700' fill='#667284'>" & "ENGAGEMENT SCORE" & "</text>"
			& "<text x='70' y='60' font-size='27' font-weight='700' fill='#0A0917'>" & IF(ISBLANK(A), "n/a", FORMAT(A, "0.00") & "<tspan font-size='14' font-weight='600' fill='#667284'> / 5</tspan>") & "</text>"
			& "<text x='70' y='87' font-size='11.5' font-weight='400' fill='#667284'>" & IF(N = 0, "no survey was run in " & Y, FORMAT(N, "#,0") & " survey responses in " & Y) & "</text>"
			& "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(Svg, "%", "%25"), "#", "%23")
		dataCategory: ImageUrl
		lineageTag: af966d07-1cb5-5bab-ba1c-09eca24cb5f1

	/// KPI tile: mean rating of the people employed at the last month-end.
	measure 'Glance Tile Rating' =
			VAR A = [Glance Rating]
			VAR Svg =
			"<svg xmlns='http://www.w3.org/2000/svg' width='235' height='104' viewBox='0 0 235 104' font-family='Segoe UI, sans-serif'><rect x='0.5' y='0.5' width='234' height='103' rx='4' fill='#FFFFFF' stroke='#E3E7EF'/><rect width='3' height='104' fill='#C9A227'/><g transform='translate(16 32) scale(0.8333)'><g fill='none' stroke-width='2.8' stroke-linecap='round' stroke-linejoin='round'><g stroke='#111F38'><path d='M24 5l5.9 12 13.1 1.9-9.5 9.3 2.2 13.1L24 35.1l-11.7 6.2 2.2-13.1L5 18.9 18.1 17z'/></g><g stroke='#C9A227'><path d='M18 25l4.5 4.5 8-9'/></g></g></g>"
			& "<text x='70' y='25' font-size='10.5' font-weight='700' fill='#667284'>" & "AVG PERFORMANCE RATING" & "</text>"
			& "<text x='70' y='60' font-size='27' font-weight='700' fill='#0A0917'>" & IF(ISBLANK(A), "n/a", FORMAT(A, "0.00") & "<tspan font-size='14' font-weight='600' fill='#667284'> / 5</tspan>") & "</text>"
			& "<text x='70' y='87' font-size='11.5' font-weight='400' fill='#667284'>" & "people employed at end " & FORMAT(DATE(2000, [YoY Last Month], 1), "mmm") & "</text>"
			& "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(Svg, "%", "%25"), "#", "%23")
		dataCategory: ImageUrl
		lineageTag: d9a96d6c-b32b-5b3a-b92c-732043733ac3

	measure 'Glance Title Department' =
			VAR Best = TOPN(1, ADDCOLUMNS(VALUES('Employee'[Department]), "@v", [Headcount]), [@v], DESC, 'Employee'[Department], ASC)
			VAR BestName = MAXX(Best, 'Employee'[Department])
			VAR BestValue = MAXX(Best, [@v])
			RETURN
			    IF([Headcount] + 0 = 0, "Nobody employed in this selection", BestName & " holds " & FORMAT(DIVIDE(BestValue, [Headcount]), "0%") & " of the headcount")
		lineageTag: 60d367c3-4589-5c7c-b288-2ee99dcfdfa7

	measure 'Glance Title Gender' =
			VAR F = CALCULATE([Headcount], KEEPFILTERS('Employee'[Gender] = "Female")) + 0
			RETURN
			    IF([Headcount] + 0 = 0, "Nobody employed in this selection", FORMAT(DIVIDE(F, [Headcount]), "0%") & " of the workforce is female")
		lineageTag: d17d7dbb-3988-5d2d-9f00-a0c12de7ed71

	measure 'Glance Title Unit' =
			VAR Best = TOPN(1, ADDCOLUMNS(VALUES('Employee'[Business Unit]), "@v", [Headcount]), [@v], DESC, 'Employee'[Business Unit], ASC)
			VAR BestName = MAXX(Best, 'Employee'[Business Unit])
			VAR BestValue = MAXX(Best, [@v])
			RETURN
			    IF([Headcount] + 0 = 0, "Nobody employed in this selection", BestName & " is the largest business unit, " & FORMAT(BestValue, "#,0") & " people")
		lineageTag: 689e6904-929e-54b1-8c3d-2ccde06c0f1e

	measure 'Glance Title Line' =
			VAR Y = [YoY Year]
			VAR A = [YoY Headcount] + 0
			VAR B = [YoY Headcount Comparison] + 0
			RETURN
			    IF([YoY Comparison Available] && B > 0,
			        "Headcount is " & IF(A >= B, "up ", "down ") & FORMAT(ABS(DIVIDE(A - B, B)), "0.0%") & " on " & FORMAT(DATE(2000, [YoY Last Month], 1), "mmm") & " " & (Y - 1),
			        "Headcount at each month-end of " & Y)
		lineageTag: 22383b57-0eaa-5670-ad5b-6cf412e88755

	measure 'Glance Subtitle Line' =
			VAR Y = [YoY Year]
			RETURN
			    IF([YoY Comparison Available], "Month-end headcount, " & Y & " against " & (Y - 1) & " (dashed)",
			        "Month-end headcount; " & (Y - 1) & " has no figures for these months")
		lineageTag: 31518978-4b66-56b0-809e-5f5fe6837da5

	measure 'Glance Title Type' =
			VAR Best = TOPN(1, ADDCOLUMNS(VALUES('Employee'[Employee Type]), "@v", [Headcount]), [@v], DESC, 'Employee'[Employee Type], ASC)
			VAR BestName = MAXX(Best, 'Employee'[Employee Type])
			VAR BestValue = MAXX(Best, [@v])
			RETURN
			    IF([Headcount] + 0 = 0, "Nobody employed in this selection", BestName & " is the largest group at " & FORMAT(DIVIDE(BestValue, [Headcount]), "0%"))
		lineageTag: c7d49afc-b73b-5ab1-8894-4ddf15799dcb

	measure 'Glance Title Roles' =
			VAR Best = TOPN(1, ADDCOLUMNS(VALUES('Employee'[Title]), "@v", [Headcount]), [@v], DESC, 'Employee'[Title], ASC)
			VAR BestName = MAXX(Best, 'Employee'[Title])
			VAR BestValue = MAXX(Best, [@v])
			RETURN
			    IF([Headcount] + 0 = 0, "Nobody employed in this selection", BestName & " is the largest role")
		lineageTag: aa31bf50-e636-5da7-a751-8c3af22095bf

	measure 'Glance Title Hires' = "The last five people to join in " & [YoY Year]
		lineageTag: b13f59d2-fdbc-5b1b-ab13-36035a94a2e6

	measure 'Glance Title Turnover' =
			VAR Best = TOPN(1, ADDCOLUMNS(VALUES('Employee'[Department]), "@v", [YoY Turnover]), [@v], DESC, 'Employee'[Department], ASC)
			VAR BestName = MAXX(Best, 'Employee'[Department])
			VAR BestValue = MAXX(Best, [@v])
			RETURN
			    IF(ISBLANK(BestValue), "Nobody left in this selection",
			        "Turnover is highest in " & BestName & ", " & FORMAT(BestValue, "0%"))
		lineageTag: d95b07a8-1926-5f1f-bc4a-70694234ff7a

	measure 'Glance Subtitle Turnover' = "Annualised turnover by department, " & [YoY Span] & " " & [YoY Year]
		lineageTag: 4c29b79c-2b97-5441-95ca-1a95b2e8edc3

	measure 'Glance Title Performance' =
			VAR Best = TOPN(1, ADDCOLUMNS(VALUES('Employee'[Performance]), "@v", [Headcount]), [@v], DESC, 'Employee'[Performance], ASC)
			VAR BestName = MAXX(Best, 'Employee'[Performance])
			VAR BestValue = MAXX(Best, [@v])
			RETURN
			    IF([Headcount] + 0 = 0, "Nobody employed in this selection", FORMAT(DIVIDE(BestValue, [Headcount]), "0%") & " are rated " & BestName)
		lineageTag: 1cfe92a0-b296-5f64-af03-676c68887ee5

	/// The join date of the employee on the row, when it falls in the year on screen.
	measure 'Glance Hire Joined' = CALCULATE(MAX('Movement'[Date]), KEEPFILTERS('Movement'[Movement] = "Joiner"))
		formatString: d mmm yyyy
		lineageTag: 9a1a76ef-33b9-528c-abc0-74f3c37969fb

	/// What the table's Top 5 filter orders by: join date, then employee number, so ties cannot
	/// let a sixth row in.
	measure 'Glance Hire Order' =
			VAR D = [Glance Hire Joined]
			RETURN
			    IF(NOT ISBLANK(D), INT(D) * 10000 + MAX('Employee'[Employee]))
		formatString: 0
		lineageTag: d350c4c2-64b5-5c62-8735-cbf0d1119ef7

	measure 'Glance Hire Department' = IF(NOT ISBLANK([Glance Hire Joined]), SELECTEDVALUE('Employee'[Department]))
		lineageTag: 113b7ef1-4963-5616-9101-c41d996caad1

	measure 'Glance Hire Role' = IF(NOT ISBLANK([Glance Hire Joined]), SELECTEDVALUE('Employee'[Title]))
		lineageTag: 65072d2e-6d7e-5c51-83fb-7ce71a814f85

	column Placeholder
		dataType: string
		isHidden
		lineageTag: 5e156f9e-09ff-50c9-b3a4-aa5374365206
		summarizeBy: none
		sourceColumn: [Placeholder]

	partition 'Glance Metrics' = calculated
		mode: import
		source = ROW("Placeholder", "")
