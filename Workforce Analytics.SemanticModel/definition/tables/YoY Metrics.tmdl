/// Measures behind page 05, Year on Year. Generated by etl/yoy_model.py - edit that, not this.
table 'YoY Metrics'
	lineageTag: 7dcda686-6722-5656-81d7-e618adbe3cf6

	/// The year on screen; the page forces a single year.
	measure 'YoY Year' = MAX('Date'[Year])
		formatString: 0
		lineageTag: 29adead8-e964-5243-888b-37b8daf56344

	measure 'YoY Choice' = SELECTEDVALUE('YoY Comparison'[Comparison], "Prior year")
		lineageTag: 1c4e0a6e-5819-5193-9bf1-3b612e265e87

	measure 'YoY Comparison Year' = [YoY Year] - IF([YoY Choice] = "Two years back", 2, 1)
		formatString: 0
		lineageTag: 41ca697e-4b15-5b29-8951-cf218aa0be06

	/// First month-end with a snapshot in the year on screen. MONTH(BLANK()) is 12, hence the guard.
	measure 'YoY First Month' =
			VAR Y = [YoY Year]
			VAR D = CALCULATE(MIN('Headcount'[Date]), REMOVEFILTERS('Employee'), REMOVEFILTERS('Date'), 'Date'[Year] = Y)
			RETURN IF(NOT ISBLANK(D), MONTH(D))
		formatString: 0
		lineageTag: 26245ab2-8b46-507d-a321-2b59c7cdd07a

	/// Last month-end with a snapshot: 7 for 2023, 12 otherwise.
	measure 'YoY Last Month' =
			VAR Y = [YoY Year]
			VAR D = CALCULATE(MAX('Headcount'[Date]), REMOVEFILTERS('Employee'), REMOVEFILTERS('Date'), 'Date'[Year] = Y)
			RETURN IF(NOT ISBLANK(D), MONTH(D))
		formatString: 0
		lineageTag: abf9e1a3-a3ac-5179-914a-4c9bec02ae27

	/// True when the comparison year has a snapshot for every month in the window.
	measure 'YoY Comparison Available' =
			VAR CY = [YoY Comparison Year]
			VAR F = [YoY First Month]
			VAR L = [YoY Last Month]
			VAR D = CALCULATE(MIN('Headcount'[Date]), REMOVEFILTERS('Employee'), REMOVEFILTERS('Date'), 'Date'[Year] = CY)
			VAR E = CALCULATE(MAX('Headcount'[Date]), REMOVEFILTERS('Employee'), REMOVEFILTERS('Date'), 'Date'[Year] = CY)
			RETURN NOT ISBLANK(D) && MONTH(D) <= F && MONTH(E) >= L
		lineageTag: c21c8b52-cef7-51b5-9f55-dac4029baca4

	/// 'Jan-Jul': the window, short.
	measure 'YoY Span' = FORMAT(DATE(2000, [YoY First Month], 1), "mmm") & "-" & FORMAT(DATE(2000, [YoY Last Month], 1), "mmm")
		lineageTag: 63b9cb60-9ccd-5e32-9515-fd8da9f8d29a

	/// People employed at the window's last month-end.
	measure 'YoY Headcount' =
			VAR F = [YoY First Month]
			VAR L = [YoY Last Month]
			RETURN
			    CALCULATE([Headcount], KEEPFILTERS('Date'[Month No] >= F && 'Date'[Month No] <= L))
		formatString: #,0
		lineageTag: 76a2c147-75ff-54fe-8f69-2da5c792ba16

	/// The same months of the comparison year; blank when there is none.
	measure 'YoY Headcount Comparison' =
			VAR CY = [YoY Comparison Year]
			VAR F = [YoY First Month]
			VAR L = [YoY Last Month]
			RETURN
			    IF([YoY Comparison Available], CALCULATE([Headcount], 'Date'[Year] = CY, KEEPFILTERS('Date'[Month No] >= F && 'Date'[Month No] <= L)))
		formatString: #,0
		lineageTag: 6b1084d9-328d-5b90-bb52-580f0c4655a2

	measure 'YoY Joiners' =
			VAR F = [YoY First Month]
			VAR L = [YoY Last Month]
			RETURN
			    CALCULATE([Joiners], KEEPFILTERS('Date'[Month No] >= F && 'Date'[Month No] <= L))
		formatString: #,0
		lineageTag: 846ec20d-3a1d-5948-96b5-4a0a94320d43

	measure 'YoY Joiners Comparison' =
			VAR CY = [YoY Comparison Year]
			VAR F = [YoY First Month]
			VAR L = [YoY Last Month]
			RETURN
			    IF([YoY Comparison Available], CALCULATE([Joiners], 'Date'[Year] = CY, KEEPFILTERS('Date'[Month No] >= F && 'Date'[Month No] <= L)))
		formatString: #,0
		lineageTag: b6032371-74b9-5683-a718-ea74b89cb5bd

	measure 'YoY Leavers' =
			VAR F = [YoY First Month]
			VAR L = [YoY Last Month]
			RETURN
			    CALCULATE([Leavers], KEEPFILTERS('Date'[Month No] >= F && 'Date'[Month No] <= L))
		formatString: #,0
		lineageTag: 632da2c6-7feb-5591-a917-4216effa5fd9

	measure 'YoY Leavers Comparison' =
			VAR CY = [YoY Comparison Year]
			VAR F = [YoY First Month]
			VAR L = [YoY Last Month]
			RETURN
			    IF([YoY Comparison Available], CALCULATE([Leavers], 'Date'[Year] = CY, KEEPFILTERS('Date'[Month No] >= F && 'Date'[Month No] <= L)))
		formatString: #,0
		lineageTag: ca251e5c-58ea-5fe5-aeb0-3b38fb2a7213

	/// Leavers who went inside their first year.
	measure 'YoY Early Leavers' =
			VAR F = [YoY First Month]
			VAR L = [YoY Last Month]
			RETURN
			    CALCULATE([Early Leavers], KEEPFILTERS('Date'[Month No] >= F && 'Date'[Month No] <= L))
		formatString: #,0
		lineageTag: 7ee3a1f8-2d1a-5d25-aa45-537ae4efac61

	measure 'YoY Early Leavers Comparison' =
			VAR CY = [YoY Comparison Year]
			VAR F = [YoY First Month]
			VAR L = [YoY Last Month]
			RETURN
			    IF([YoY Comparison Available], CALCULATE([Early Leavers], 'Date'[Year] = CY, KEEPFILTERS('Date'[Month No] >= F && 'Date'[Month No] <= L)))
		formatString: #,0
		lineageTag: 1884163b-f6fd-5e88-a80b-e56ae5786762

	/// Mean of the window's month-ends; 0 rather than blank for a group with nobody.
	measure 'YoY Average Headcount' =
			VAR F = [YoY First Month]
			VAR L = [YoY Last Month]
			RETURN
			    CALCULATE([Average Headcount], KEEPFILTERS('Date'[Month No] >= F && 'Date'[Month No] <= L))
		formatString: #,0.0
		lineageTag: 8200d7ea-06b8-5b6f-bf3e-ed4d8aa95a0f

	measure 'YoY Average Headcount Comparison' =
			VAR CY = [YoY Comparison Year]
			VAR F = [YoY First Month]
			VAR L = [YoY Last Month]
			RETURN
			    IF([YoY Comparison Available], CALCULATE([Average Headcount], 'Date'[Year] = CY, KEEPFILTERS('Date'[Month No] >= F && 'Date'[Month No] <= L)))
		formatString: #,0.0
		lineageTag: 2406f9f3-6609-5784-9709-5992cd8bf9eb

	measure 'YoY Months' =
			VAR F = [YoY First Month]
			VAR L = [YoY Last Month]
			RETURN
			    CALCULATE([Months in View], KEEPFILTERS('Date'[Month No] >= F && 'Date'[Month No] <= L))
		formatString: 0
		lineageTag: cb7ce6e0-8819-54a8-8683-2437cb373df7

	measure 'YoY Months Comparison' =
			VAR CY = [YoY Comparison Year]
			VAR F = [YoY First Month]
			VAR L = [YoY Last Month]
			RETURN
			    IF([YoY Comparison Available], CALCULATE([Months in View], 'Date'[Year] = CY, KEEPFILTERS('Date'[Month No] >= F && 'Date'[Month No] <= L)))
		formatString: 0
		lineageTag: cbc75147-1616-5125-a04e-52907ba4296b

	/// Annualised over the window. Differs from page 01's 2023 figure (62.8%), which also counts
	/// the leavers of 1-6 August; this page compares whole months only.
	measure 'YoY Turnover' = DIVIDE(([YoY Leavers] + 0) * 12, [YoY Average Headcount] * [YoY Months])
		formatString: 0.0%
		lineageTag: 5247a0aa-d9d9-56d6-98a3-8fa7adf0f760

	measure 'YoY Turnover Comparison' = IF([YoY Comparison Available], DIVIDE(([YoY Leavers Comparison] + 0) * 12, [YoY Average Headcount Comparison] * [YoY Months Comparison]))
		formatString: 0.0%
		lineageTag: eacc2763-3f94-5878-94e8-79c0200415cb

	/// In ratio terms: 0.377 is 37.7 points.
	measure 'YoY Turnover Change' = IF([YoY Comparison Available], [YoY Turnover] - [YoY Turnover Comparison])
		formatString: 0.0%
		lineageTag: ce7f8e7d-1b01-5fe1-8b8e-43556088df8e

	/// The change in points, for the department table.
	measure 'YoY Turnover Change pp' = ROUND([YoY Turnover Change] * 100, 1)
		formatString: +0.0;-0.0;0.0
		lineageTag: b84fba32-354a-554b-a944-94877c42ad0e

	measure 'YoY Early Share' = DIVIDE([YoY Early Leavers] + 0, [YoY Leavers])
		formatString: 0.0%
		lineageTag: 2dbff84b-0279-59af-b090-c95e92ad4c54

	measure 'YoY Early Share Comparison' = DIVIDE([YoY Early Leavers Comparison] + 0, [YoY Leavers Comparison])
		formatString: 0.0%
		lineageTag: 0a7ffa8d-662c-568a-8885-86644e1b9d9c

	/// More leavers than the same months of the comparison year. A rise is bad.
	measure 'YoY Leaver Change' =
			IF(
			    [YoY Comparison Available] && (NOT ISBLANK([YoY Leavers]) || NOT ISBLANK([YoY Leavers Comparison])),
			    ([YoY Leavers] + 0) - ([YoY Leavers Comparison] + 0)
			)
		formatString: +#,0;-#,0;0
		lineageTag: 65cc3ce6-57bf-5fe4-b22d-779d5a0f84e0

	measure 'Dept Headcount' = IF([YoY Comparison Available], [YoY Headcount])
		formatString: #,0
		lineageTag: c6e66a7f-6d6f-5ba7-abd9-fdc08fca121e

	measure 'Dept Turnover' = IF([YoY Comparison Available], [YoY Turnover])
		formatString: 0.0%
		lineageTag: 921ca619-cd54-5614-8bbd-37ac3a45ab43

	measure 'Dept Leavers' = IF([YoY Comparison Available] && ([YoY Average Headcount] > 0 || [YoY Average Headcount Comparison] > 0), [YoY Leavers] + 0)
		formatString: #,0
		lineageTag: afca6fc2-c0f0-57fc-a33f-ea34ee6cb394

	measure 'Dept Leavers Comparison' = IF([YoY Comparison Available] && ([YoY Average Headcount] > 0 || [YoY Average Headcount Comparison] > 0), [YoY Leavers Comparison] + 0)
		formatString: #,0
		lineageTag: df161e35-65c3-5f48-b795-8ca76ec58ec2

	measure 'Dept Turnover Colour' = IF([YoY Turnover Change] > 0, "#B3261E", "#1E7A4C")
		lineageTag: f72b6690-02ca-55f5-9b32-1fdb55ff41c4

	/// ALLSELECTED: no measure filter on the department table narrows it.
	measure 'Departments In Play' = IF([YoY Comparison Available], COUNTROWS(FILTER(ALLSELECTED('Employee'[Department]), [YoY Average Headcount] > 0 || [YoY Average Headcount Comparison] > 0)))
		formatString: 0
		lineageTag: 874a39e7-01d1-541a-9454-e333765cc14b

	measure 'Departments Up' = IF([YoY Comparison Available], COUNTROWS(FILTER(FILTER(ALLSELECTED('Employee'[Department]), [YoY Average Headcount] > 0 || [YoY Average Headcount Comparison] > 0), [YoY Turnover Change] > 0)))
		formatString: 0
		lineageTag: 2b296f7e-3d3a-5e5c-abf7-0cf813f8d127

	/// Diverging bar for a department's change in turnover, red for a rise.
	measure 'Dept Turnover Bar' =
			VAR Change = [YoY Turnover Change]
			VAR Scale = MAXX(FILTER(ALLSELECTED('Employee'[Department]), [YoY Average Headcount] > 0 || [YoY Average Headcount Comparison] > 0), ABS([YoY Turnover Change]))
			VAR W = DIVIDE(ABS(Change), Scale) * 56
			VAR X = IF(Change >= 0, 60, 60 - W)
			VAR Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='120' height='16' viewBox='0 0 120 16'>"
			        & "<line x1='60' y1='0' x2='60' y2='16' stroke='#667284'/>"
			        & "<rect x='" & FORMAT(X, "0.0") & "' y='3' width='" & FORMAT(W, "0.0") & "' height='10' fill='" & IF(Change > 0, "#B3261E", "#1E7A4C") & "'/>"
			        & "</svg>"
			RETURN
			    IF(NOT ISBLANK(Change) && HASONEVALUE('Employee'[Department]), "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(Svg, "%", "%25"), "#", "%23"))
		dataCategory: ImageUrl
		lineageTag: cd30f583-a376-5e37-99cd-99f2a3e8cb9b

	measure 'Division Leavers' = IF(NOT ISBLANK([Division Rank]), [YoY Leavers] + 0)
		formatString: #,0
		lineageTag: 783aace9-9839-5967-98cc-9c04c2a6db43

	measure 'Division Leavers Comparison' = IF(NOT ISBLANK([Division Rank]), [YoY Leavers Comparison] + 0)
		formatString: #,0
		lineageTag: e2c1b471-dbcf-5d28-baf4-01a857811b43

	/// Divisions with a leaver in either period.
	measure 'Divisions In Play' = IF([YoY Comparison Available], COUNTROWS(FILTER(ALL('Employee'[Division]), NOT ISBLANK([YoY Leavers]) || NOT ISBLANK([YoY Leavers Comparison]))))
		formatString: 0
		lineageTag: b8821afb-c8eb-5005-9752-7833af687cbb

	measure 'Divisions Up' = IF([YoY Comparison Available], COUNTROWS(FILTER(FILTER(ALL('Employee'[Division]), NOT ISBLANK([YoY Leavers]) || NOT ISBLANK([YoY Leavers Comparison])), [YoY Leaver Change] > 0)))
		formatString: 0
		lineageTag: 0c0c4156-0814-59a9-8b8b-9e251e42962e

	/// Alphabetical position, the last tiebreak for the rank.
	measure 'Division Name Order' =
			VAR N = SELECTEDVALUE('Employee'[Division])
			RETURN COUNTROWS(FILTER(ALL('Employee'[Division]), 'Employee'[Division] < N))
		formatString: 0
		isHidden
		lineageTag: f4dad0bf-a718-5f42-a495-b4d493136ddd

	/// Position by change in leavers, from the top or the bottom as 'Division Ranking' says. Ties on
	/// the change go to more leavers (Top) or fewer (Bottom), then to the name, so exactly 8
	/// rows show. The table keeps ranks 1 to 8 with
	/// a visual-level filter. ALL pool: that filter narrows ALLSELECTED.
	measure 'Division Rank' =
			VAR Direction = SELECTEDVALUE('Division Ranking'[Show], "Top")
			VAR Pool = FILTER(ALL('Employee'[Division]), NOT ISBLANK([YoY Leavers]) || NOT ISBLANK([YoY Leavers Comparison]))
			VAR Me = (([YoY Leaver Change] * 1000 + [YoY Leavers] + 0) * 100 - [Division Name Order])
			RETURN
			    IF(
			        HASONEVALUE('Employee'[Division]) && [YoY Comparison Available]
			            && (NOT ISBLANK([YoY Leavers]) || NOT ISBLANK([YoY Leavers Comparison])),
			        IF(
			            Direction = "Top",
			            COUNTROWS(FILTER(Pool, (([YoY Leaver Change] * 1000 + [YoY Leavers] + 0) * 100 - [Division Name Order]) > Me)) + 1,
			            COUNTROWS(FILTER(Pool, (([YoY Leaver Change] * 1000 + [YoY Leavers] + 0) * 100 - [Division Name Order]) < Me)) + 1
			        )
			    )
		formatString: 0
		lineageTag: 7a8ebd31-1ac4-5602-9021-b8ec1d35c07b

	measure 'Division Change Colour' = IF([YoY Leaver Change] > 0, "#B3261E", "#1E7A4C")
		lineageTag: 54c433db-3a70-5ca8-bfb9-086bdbb67559

	/// Diverging bar for a division's change in leavers, one scale for Top and Bottom.
	measure 'Division Leaver Bar' =
			VAR Change = [YoY Leaver Change]
			VAR Scale = MAXX(FILTER(ALL('Employee'[Division]), NOT ISBLANK([YoY Leavers]) || NOT ISBLANK([YoY Leavers Comparison])), ABS([YoY Leaver Change]))
			VAR W = DIVIDE(ABS(Change), Scale) * 56
			VAR X = IF(Change >= 0, 60, 60 - W)
			VAR Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='120' height='16' viewBox='0 0 120 16'>"
			        & "<line x1='60' y1='0' x2='60' y2='16' stroke='#667284'/>"
			        & "<rect x='" & FORMAT(X, "0.0") & "' y='3' width='" & FORMAT(W, "0.0") & "' height='10' fill='" & IF(Change > 0, "#B3261E", "#1E7A4C") & "'/>"
			        & "</svg>"
			RETURN
			    IF(NOT ISBLANK([Division Rank]), "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(Svg, "%", "%25"), "#", "%23"))
		dataCategory: ImageUrl
		lineageTag: 9bfd5f5d-f249-54b1-be01-6c71ac3f0a3d

	measure 'YoY Chart Choice' = SELECTEDVALUE('YoY Chart Metric'[Metric], "Leavers")
		lineageTag: 5d397ba7-bbdf-58f2-a637-87f0cb6011af

	measure 'YoY Chart This' = IF([YoY Comparison Available], SWITCH([YoY Chart Choice], "Headcount", [YoY Headcount], "Joiners", [YoY Joiners], [YoY Leavers]))
		formatString: #,0
		lineageTag: 854074c4-54a7-5a6a-9920-e2e3dd064de1

	measure 'YoY Chart Comparison' = SWITCH([YoY Chart Choice], "Headcount", [YoY Headcount Comparison], "Joiners", [YoY Joiners Comparison], [YoY Leavers Comparison])
		formatString: #,0
		lineageTag: f49c8e02-2202-5803-a41f-c8cfc462a5b5

	measure 'YoY Chart Change' = IF([YoY Comparison Available] && NOT ISBLANK([YoY Chart This]), ([YoY Chart This] + 0) - ([YoY Chart Comparison] + 0))
		formatString: +#,0;-#,0;0
		lineageTag: 2083acb6-1e2b-59e1-ae34-035a5ed6500f

	/// More leavers is red; more headcount or joiners is green.
	measure 'YoY Chart Change Colour' = IF(NOT ISBLANK([YoY Chart Change]), IF([YoY Chart Choice] = "Leavers", IF([YoY Chart Change] > 0, "#B3261E", "#1E7A4C"), IF([YoY Chart Change] >= 0, "#1E7A4C", "#B3261E")))
		lineageTag: 55ffbc23-454c-5011-b484-254f371db39b

	/// The page's summary, or why there is nothing to compare with.
	measure 'YoY Standfirst' =
			VAR Y = [YoY Year]
			VAR CY = [YoY Comparison Year]
			VAR F = [YoY First Month]
			VAR L = [YoY Last Month]
			VAR CF = CALCULATE(MIN('Headcount'[Date]), REMOVEFILTERS('Employee'), REMOVEFILTERS('Date'), 'Date'[Year] = CY)
			VAR CL = CALCULATE(MAX('Headcount'[Date]), REMOVEFILTERS('Employee'), REMOVEFILTERS('Date'), 'Date'[Year] = CY)
			VAR Lv = [YoY Leavers] + 0
			VAR LvC = [YoY Leavers Comparison] + 0
			VAR J = [YoY Joiners] + 0
			VAR JC = [YoY Joiners Comparison] + 0
			VAR Opening = IF(F = 1 && L = 12, Y & " against " & CY, FORMAT(DATE(Y, F, 1), "mmmm") & " to " & FORMAT(DATE(Y, L, 1), "mmmm yyyy") & " against the same months of " & CY)
			RETURN
			    IF(
			        NOT [YoY Comparison Available],
			        Y & " has nothing to compare with: "
			            & IF(ISBLANK(CF), CY & " is before the records start.", "the records hold only " & FORMAT(CF, "mmmm") & " to " & FORMAT(CL, "mmmm yyyy") & "."),
			        Opening & ": leavers " & IF(Lv >= LvC, "up", "down") & " from " & FORMAT(LvC, "#,0") & " to " & FORMAT(Lv, "#,0")
			            & ", joiners " & IF(J >= JC, "up", "down") & " from " & FORMAT(JC, "#,0") & " to " & FORMAT(J, "#,0")
			            & ". Annualised turnover went from " & FORMAT([YoY Turnover Comparison], "0.0%") & " to " & FORMAT([YoY Turnover], "0.0%")
			            & ", and headcount " & IF([YoY Headcount] >= [YoY Headcount Comparison], "rose", "fell") & " to " & FORMAT([YoY Headcount], "#,0") & "."
			    )
		lineageTag: 628a691d-3a9b-5361-b15d-d99aabc001cc

	measure 'YoY Title Line Chart' = [YoY Chart Choice] & " by month, " & [YoY Year] & " against " & [YoY Comparison Year]
		lineageTag: 863e9822-2b8b-5943-afe3-001da2b7eef5

	measure 'YoY Subtitle Line Chart' =
			VAR Above = COUNTROWS(FILTER(VALUES('Date'[Month No]), [YoY Chart Change] > 0))
			VAR Months = COUNTROWS(FILTER(VALUES('Date'[Month No]), NOT ISBLANK([YoY Chart Change])))
			RETURN
			    IF([YoY Comparison Available], "Above " & [YoY Comparison Year] & " in " & Above & " of " & Months & " months")
		lineageTag: 28970eb2-1053-51ba-8146-af69a6e66fe8

	measure 'YoY Title Variance Chart' = "Which months moved " & LOWER([YoY Chart Choice])
		lineageTag: 7ad5f11c-8f42-506d-8908-5ce394465470

	measure 'YoY Subtitle Variance Chart' =
			VAR ByMonth = FILTER(ADDCOLUMNS(VALUES('Date'[Month No]), "@V", [YoY Chart Change]), NOT ISBLANK([@V]))
			VAR Most = TOPN(1, ByMonth, ABS([@V]), DESC, 'Date'[Month No], ASC)
			VAR V = MAXX(Most, [@V])
			VAR MonthName = FORMAT(DATE(2000, MAXX(Most, 'Date'[Month No]), 1), "mmm")
			RETURN
			    IF(
			        [YoY Comparison Available],
			        [YoY Year] & " less " & [YoY Comparison Year] & ", by month: " & MonthName & " moved most ("
			            & IF(V < 0, "-", "+") & FORMAT(ABS(V), "#,0") & ")"
			    )
		lineageTag: fd6ce5b0-a122-52af-bcd3-4622e17629b4

	measure 'YoY Title Department Table' = "Turnover by department, " & [YoY Year] & " against " & [YoY Comparison Year]
		lineageTag: cbdf67a8-5da1-5600-ad2f-7431e5405619

	/// Names the headcount when the biggest rise sits on fewer than 50 people.
	measure 'YoY Subtitle Department Table' =
			VAR N = [Departments In Play]
			VAR Up = [Departments Up]
			VAR MostRow = TOPN(1, ADDCOLUMNS(FILTER(ALLSELECTED('Employee'[Department]), [YoY Average Headcount] > 0 || [YoY Average Headcount Comparison] > 0), "@V", [YoY Turnover Change], "@H", [YoY Headcount]), [@V], DESC, 'Employee'[Department], ASC)
			VAR H = MAXX(MostRow, [@H])
			RETURN
			    IF(
			        [YoY Comparison Available],
			        "Annualised over " & [YoY Span] & "; "
			            & IF(
			                Up = 0,
			                "down in all " & N,
			                "up in " & Up & " of " & N & ", most in " & MAXX(MostRow, 'Employee'[Department])
			                    & IF(H < 50, " (" & FORMAT(H + 0, "#,0") & IF(H = 1, " person)", " people)"))
			            )
			    )
		lineageTag: d3be4207-5966-5ee8-894b-a6e065e9b342

	measure 'YoY Title Division Table' =
			IF(
			    SELECTEDVALUE('Division Ranking'[Show], "Top") = "Top",
			    "The 8 divisions where leavers rose most",
			    "The 8 divisions where leavers rose least"
			)
		lineageTag: c12754a4-b5f7-58ea-ad5a-d29c01f4ec09

	measure 'YoY Subtitle Division Table' = IF([YoY Comparison Available], "Leavers " & [YoY Span] & " " & [YoY Year] & " less the same months of " & [YoY Comparison Year])
		lineageTag: 468b3223-76a9-5cf8-9bbe-ea47805f4e6b

	measure 'YoY Filter Summary' =
			VAR Names =
			    FILTER(
			        {
			            ("business unit", ISFILTERED('Employee'[Business Unit]), 1),
			            ("employee type", ISFILTERED('Employee'[Employee Type]), 2)
			        },
			        [Value2]
			    )
			RETURN
			    IF(COUNTROWS(Names) = 0, "No filters applied", "Filtered by " & CONCATENATEX(Names, [Value1], ", ", [Value3], ASC))
		lineageTag: ccded815-ad10-5dd6-aa65-0fa6ff197bbd

	/// Headcount at the window's end against the same month-end, joiners, and the net change.
	measure 'YoY Card Headcount' =
			VAR Y = [YoY Year]
			VAR CY = [YoY Comparison Year]
			VAR MonthName = UPPER(FORMAT(DATE(2000, [YoY Last Month], 1), "mmm"))
			VAR Span = [YoY Span]
			VAR A = [YoY Headcount] + 0
			VAR B = [YoY Headcount Comparison] + 0
			VAR P = DIVIDE(A - B, B)
			VAR J = [YoY Joiners] + 0
			VAR JC = [YoY Joiners Comparison] + 0
			VAR JP = DIVIDE(J - JC, JC)
			VAR Net = J - ([YoY Leavers] + 0)
			VAR Ratio = DIVIDE(A, B)
			VAR Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='336' height='140' viewBox='0 0 336 140' font-family='Segoe UI, sans-serif'>"
			    & "<rect x='0.5' y='0.5' width='335' height='139' rx='4' fill='#FFFFFF' stroke='#E3E7EF'/><rect width='3' height='140' fill='#C9A227'/>"
			    & "<text x='16' y='24' font-size='11' font-weight='700' fill='#667284' letter-spacing='0.4'>" & "HEADCOUNT, END " & MonthName & " " & Y & "</text>"
			    & "<g transform='translate(16 33) scale(0.625)'><g fill='none' stroke-width='2.8' stroke-linecap='round' stroke-linejoin='round'><g stroke='#111F38'><circle cx='24' cy='15' r='6.5'/><path d='M13.0 40c0-13 22-13 22 0'/></g><g stroke='#C9A227'><circle cx='9' cy='20' r='4.5'/><path d='M2.0 38c0-9 14-9 14 0'/><circle cx='39' cy='20' r='4.5'/><path d='M32.0 38c0-9 14-9 14 0'/></g></g></g>"
			    & "<text x='56' y='58' font-size='28' font-weight='700' fill='#0A0917'>" & FORMAT(A, "#,0") & "</text>"
			    & "<text x='16' y='76' font-size='11.5' fill='#667284'>" & IF(ISBLANK(P), "new", IF(P < 0, "&#8722;", "+") & FORMAT(ABS(P), "0.0%")) & " on " & FORMAT(DATE(2000, [YoY Last Month], 1), "mmm") & " " & CY & " (" & FORMAT(B, "#,0") & ")" & "</text>"
			    & "<line x1='16' y1='88' x2='320' y2='88' stroke='#E3E7EF'/>"
			    & "<text x='16' y='107' font-size='11.5' fill='#4A5768'>" & "Joiners, " & Span & " &#183; " & FORMAT(J, "#,0") & "</text><text x='320' y='107' font-size='11.5' font-weight='600' text-anchor='end' fill='" & IF(J - JC >= 0, "#1E7A4C", "#B3261E") & "'>" & IF(ISBLANK(JP), "new", IF(JP < 0, "&#8722;", "+") & FORMAT(ABS(JP), "0.0%")) & "</text>"
			    & "<text x='16' y='127' font-size='11.5' fill='#4A5768'>" & "Net change, " & Span & "</text><text x='320' y='127' font-size='11.5' font-weight='600' text-anchor='end' fill='" & IF(Net >= 0, "#1E7A4C", "#B3261E") & "'>" & IF(Net < 0, "&#8722;", "+") & FORMAT(ABS(Net), "#,0") & "</text>"
			    & "<circle cx='286' cy='42' r='26' stroke='#E3E7EF' stroke-width='7' fill='none'/>" & IF(MAX(MIN(Ratio, 1), 0) > 0, "<path d='M286,16 A26,26 0 " & IF(MAX(MIN(Ratio, 1), 0) > 0.5, "1", "0") & " 1 " & FORMAT(286 + 26 * COS(2 * PI() * MIN(MAX(MIN(Ratio, 1), 0), 0.9999) - PI() / 2), "0.00") & "," & FORMAT(42 + 26 * SIN(2 * PI() * MIN(MAX(MIN(Ratio, 1), 0), 0.9999) - PI() / 2), "0.00") & "' stroke='#111F38' stroke-width='7' fill='none'/>") & IF(Ratio - 1 > 0, "<path d='M286,16 A26,26 0 " & IF(Ratio - 1 > 0.5, "1", "0") & " 1 " & FORMAT(286 + 26 * COS(2 * PI() * MIN(Ratio - 1, 0.9999) - PI() / 2), "0.00") & "," & FORMAT(42 + 26 * SIN(2 * PI() * MIN(Ratio - 1, 0.9999) - PI() / 2), "0.00") & "' stroke='#C9A227' stroke-width='7' fill='none'/>") & "<text x='286' y='47' font-size='13' font-weight='700' text-anchor='middle' fill='#0A0917'>" & FORMAT(Ratio, "0%") & "</text>"
			    & "</svg>"
			VAR NoComparison = "<svg xmlns='http://www.w3.org/2000/svg' width='336' height='140' viewBox='0 0 336 140' font-family='Segoe UI, sans-serif'><rect x='0.5' y='0.5' width='335' height='139' rx='4' fill='#FFFFFF' stroke='#E3E7EF'/><text x='16' y='24' font-size='11' font-weight='700' fill='#667284'>HEADCOUNT</text><text x='16' y='64' font-size='13' fill='#4A5768'>Nothing to compare with for this year.</text></svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(IF([YoY Comparison Available], Svg, NoComparison), "%", "%25"), "#", "%23")
		dataCategory: ImageUrl
		lineageTag: d1a7874b-604d-5605-b2ea-552c86f104e1

	/// Leavers against the same months, the year-one share, and joiners per leaver. The ring passes
	/// 100% in gold when leavers rose.
	measure 'YoY Card Leavers' =
			VAR Y = [YoY Year]
			VAR CY = [YoY Comparison Year]
			VAR Span = UPPER([YoY Span])
			VAR A = [YoY Leavers] + 0
			VAR B = [YoY Leavers Comparison] + 0
			VAR P = DIVIDE(A - B, B)
			VAR ES = [YoY Early Share]
			VAR ESC = [YoY Early Share Comparison]
			VAR JPL = DIVIDE([YoY Joiners] + 0, A)
			VAR JPLC = DIVIDE([YoY Joiners Comparison] + 0, B)
			VAR Ratio = DIVIDE(A, B)
			VAR Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='336' height='140' viewBox='0 0 336 140' font-family='Segoe UI, sans-serif'>"
			    & "<rect x='0.5' y='0.5' width='335' height='139' rx='4' fill='#FFFFFF' stroke='#E3E7EF'/><rect width='3' height='140' fill='#C9A227'/>"
			    & "<text x='16' y='24' font-size='11' font-weight='700' fill='#667284' letter-spacing='0.4'>" & "LEAVERS, " & Span & " " & Y & "</text>"
			    & "<g transform='translate(16 33) scale(0.625)'><g fill='none' stroke-width='2.8' stroke-linecap='round' stroke-linejoin='round'><g stroke='#111F38'><path d='M26 6H8v36h18'/><circle cx='20' cy='24' r='1.6'/></g><g stroke='#C9A227'><path d='M22 24h20M35 17l7 7-7 7'/></g></g></g>"
			    & "<text x='56' y='58' font-size='28' font-weight='700' fill='#0A0917'>" & FORMAT(A, "#,0") & "</text>"
			    & "<text x='16' y='76' font-size='11.5' fill='#667284'>" & IF(ISBLANK(P), "new", IF(P < 0, "&#8722;", "+") & FORMAT(ABS(P), "0.0%")) & " on " & CY & " (" & FORMAT(B, "#,0") & ")" & "</text>"
			    & "<line x1='16' y1='88' x2='320' y2='88' stroke='#E3E7EF'/>"
			    & "<text x='16' y='107' font-size='11.5' fill='#4A5768'>" & "Left in year one &#183; " & FORMAT(ES, "0.0%") & "</text><text x='320' y='107' font-size='11.5' font-weight='600' text-anchor='end' fill='" & IF(ES - ESC > 0, "#B3261E", "#1E7A4C") & "'>" & IF(ES - ESC < 0, "&#8722;", "+") & FORMAT(ABS(ES - ESC) * 100, "0.0") & "pp" & "</text>"
			    & "<text x='16' y='127' font-size='11.5' fill='#4A5768'>" & "Joiners per leaver &#183; " & FORMAT(JPL, "0.00") & "</text><text x='320' y='127' font-size='11.5' font-weight='600' text-anchor='end' fill='" & IF(JPL - JPLC >= 0, "#1E7A4C", "#B3261E") & "'>" & "was " & FORMAT(JPLC, "0.00") & "</text>"
			    & "<circle cx='286' cy='42' r='26' stroke='#E3E7EF' stroke-width='7' fill='none'/>" & IF(MAX(MIN(Ratio, 1), 0) > 0, "<path d='M286,16 A26,26 0 " & IF(MAX(MIN(Ratio, 1), 0) > 0.5, "1", "0") & " 1 " & FORMAT(286 + 26 * COS(2 * PI() * MIN(MAX(MIN(Ratio, 1), 0), 0.9999) - PI() / 2), "0.00") & "," & FORMAT(42 + 26 * SIN(2 * PI() * MIN(MAX(MIN(Ratio, 1), 0), 0.9999) - PI() / 2), "0.00") & "' stroke='#111F38' stroke-width='7' fill='none'/>") & IF(Ratio - 1 > 0, "<path d='M286,16 A26,26 0 " & IF(Ratio - 1 > 0.5, "1", "0") & " 1 " & FORMAT(286 + 26 * COS(2 * PI() * MIN(Ratio - 1, 0.9999) - PI() / 2), "0.00") & "," & FORMAT(42 + 26 * SIN(2 * PI() * MIN(Ratio - 1, 0.9999) - PI() / 2), "0.00") & "' stroke='#C9A227' stroke-width='7' fill='none'/>") & "<text x='286' y='47' font-size='13' font-weight='700' text-anchor='middle' fill='#0A0917'>" & FORMAT(Ratio, "0%") & "</text>"
			    & "</svg>"
			VAR NoComparison = "<svg xmlns='http://www.w3.org/2000/svg' width='336' height='140' viewBox='0 0 336 140' font-family='Segoe UI, sans-serif'><rect x='0.5' y='0.5' width='335' height='139' rx='4' fill='#FFFFFF' stroke='#E3E7EF'/><text x='16' y='24' font-size='11' font-weight='700' fill='#667284'>LEAVERS</text><text x='16' y='64' font-size='13' fill='#4A5768'>Nothing to compare with for this year.</text></svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(IF([YoY Comparison Available], Svg, NoComparison), "%", "%25"), "#", "%23")
		dataCategory: ImageUrl
		lineageTag: e31ccc12-c2ba-532d-839e-032172f8fe6a

	/// Annualised turnover in both periods as two bars, and the departments that moved most and least.
	measure 'YoY Card Turnover' =
			VAR Y = [YoY Year]
			VAR CY = [YoY Comparison Year]
			VAR T = [YoY Turnover] + 0
			VAR TC = [YoY Turnover Comparison] + 0
			VAR Change = T - TC
			VAR Depts = ADDCOLUMNS(FILTER(ALLSELECTED('Employee'[Department]), [YoY Average Headcount] > 0 || [YoY Average Headcount Comparison] > 0), "@V", [YoY Turnover Change])
			VAR HighRow = TOPN(1, Depts, [@V], DESC, 'Employee'[Department], ASC)
			VAR LowRow = TOPN(1, Depts, [@V], ASC, 'Employee'[Department], ASC)
			VAR HighValue = MAXX(HighRow, [@V])
			VAR LowValue = MAXX(LowRow, [@V])
			VAR Scale = DIVIDE(116, MAX(T, TC))
			VAR Bars =
			    "<text x='176' y='24' font-size='9' fill='#7C8598'>" & Y & "</text>"
			        & "<rect x='204' y='16' width='" & FORMAT(T * Scale, "0.0") & "' height='10' fill='#111F38'/>"
			        & "<text x='176' y='44' font-size='9' fill='#7C8598'>" & CY & "</text>"
			        & "<rect x='204' y='36' width='" & FORMAT(TC * Scale, "0.0") & "' height='10' fill='#7C8598'/>"
			VAR Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='336' height='140' viewBox='0 0 336 140' font-family='Segoe UI, sans-serif'>"
			    & "<rect x='0.5' y='0.5' width='335' height='139' rx='4' fill='#FFFFFF' stroke='#E3E7EF'/><rect width='3' height='140' fill='#C9A227'/>"
			    & "<text x='16' y='24' font-size='11' font-weight='700' fill='#667284' letter-spacing='0.4'>" & "TURNOVER, ANNUALISED" & "</text>"
			    & "<g transform='translate(16 33) scale(0.625)'><g fill='none' stroke-width='2.8' stroke-linecap='round' stroke-linejoin='round'><g stroke='#111F38'><path d='M8 22a16 16 0 0 1 28-9M37 4v9h-9'/></g><g stroke='#C9A227'><path d='M40 26a16 16 0 0 1-28 9M11 44v-9h9'/></g></g></g>"
			    & "<text x='56' y='58' font-size='28' font-weight='700' fill='#0A0917'>" & FORMAT(T, "0.0%") & "</text>"
			    & "<text x='16' y='76' font-size='11.5' fill='#667284'>" & IF(Change < 0, "&#8722;", "+") & FORMAT(ABS(Change) * 100, "0.0") & "pp" & " on " & CY & " (" & FORMAT(TC, "0.0%") & ")" & "</text>"
			    & "<line x1='16' y1='88' x2='320' y2='88' stroke='#E3E7EF'/>"
			    & "<text x='16' y='107' font-size='11.5' fill='#4A5768'>" & IF(HighValue > 0, "Biggest rise &#183; ", "Smallest fall &#183; ") & LEFT(MAXX(HighRow, 'Employee'[Department]), 22) & "</text><text x='320' y='107' font-size='11.5' font-weight='600' text-anchor='end' fill='" & IF(HighValue > 0, "#B3261E", "#1E7A4C") & "'>" & IF(HighValue < 0, "&#8722;", "+") & FORMAT(ABS(HighValue) * 100, "0.0") & "pp" & "</text>"
			    & "<text x='16' y='127' font-size='11.5' fill='#4A5768'>" & IF(LowValue > 0, "Smallest rise &#183; ", "Biggest fall &#183; ") & LEFT(MAXX(LowRow, 'Employee'[Department]), 22) & "</text><text x='320' y='127' font-size='11.5' font-weight='600' text-anchor='end' fill='" & IF(LowValue > 0, "#B3261E", "#1E7A4C") & "'>" & IF(LowValue < 0, "&#8722;", "+") & FORMAT(ABS(LowValue) * 100, "0.0") & "pp" & "</text>"
			    & Bars
			    & "</svg>"
			VAR NoComparison = "<svg xmlns='http://www.w3.org/2000/svg' width='336' height='140' viewBox='0 0 336 140' font-family='Segoe UI, sans-serif'><rect x='0.5' y='0.5' width='335' height='139' rx='4' fill='#FFFFFF' stroke='#E3E7EF'/><text x='16' y='24' font-size='11' font-weight='700' fill='#667284'>TURNOVER, ANNUALISED</text><text x='16' y='64' font-size='13' fill='#4A5768'>Nothing to compare with for this year.</text></svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(IF([YoY Comparison Available], Svg, NoComparison), "%", "%25"), "#", "%23")
		dataCategory: ImageUrl
		lineageTag: 1ec8b53a-0a98-5a4b-b1be-1525eada0209

	/// Every division with a leaver in either period as a bar, from the largest rise to the largest fall.
	measure 'YoY Card Divisions' =
			VAR Divisions = ADDCOLUMNS(FILTER(ALL('Employee'[Division]), NOT ISBLANK([YoY Leavers]) || NOT ISBLANK([YoY Leavers Comparison])), "@V", [YoY Leaver Change])
			VAR Scale = MAXX(Divisions, ABS([@V]))
			VAR UpRow = TOPN(1, Divisions, [@V], DESC, 'Employee'[Division], ASC)
			VAR DownRow = TOPN(1, Divisions, [@V], ASC, 'Employee'[Division], ASC)
			VAR UpValue = MAXX(UpRow, [@V])
			VAR DownValue = MAXX(DownRow, [@V])
			VAR Bars =
			    "<line x1='176' y1='46' x2='320' y2='46' stroke='#E3E7EF'/>"
			        & CONCATENATEX(
			            Divisions,
			            VAR Change = [@V]
			            VAR I = COUNTROWS(FILTER(Divisions, [@V] > Change))
			            VAR H = MAX(1.5, 20 * DIVIDE(ABS(Change), Scale))
			            RETURN
			                "<rect x='" & FORMAT(176 + I * 5.8, "0.0") & "' y='" & FORMAT(IF(Change >= 0, 46 - H, 46), "0.0")
			                    & "' width='4.2' height='" & FORMAT(H, "0.0") & "' fill='" & IF(Change > 0, "#B3261E", "#1E7A4C") & "'/>",
			            ""
			        )
			VAR Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='336' height='140' viewBox='0 0 336 140' font-family='Segoe UI, sans-serif'>"
			    & "<rect x='0.5' y='0.5' width='335' height='139' rx='4' fill='#FFFFFF' stroke='#E3E7EF'/><rect width='3' height='140' fill='#C9A227'/>"
			    & "<text x='16' y='24' font-size='11' font-weight='700' fill='#667284' letter-spacing='0.4'>" & "DIVISIONS WITH MORE LEAVERS" & "</text>"
			    & "<g transform='translate(16 33) scale(0.625)'><g fill='none' stroke-width='2.8' stroke-linecap='round' stroke-linejoin='round'><g stroke='#111F38'><path d='M24 5l19 10-19 10L5 15z'/><path d='M5 24l19 10 19-10'/></g><g stroke='#C9A227'><path d='M5 33l19 10 19-10'/></g></g></g>"
			    & "<text x='56' y='58' font-size='28' font-weight='700' fill='#0A0917'>" & FORMAT([Divisions Up] + 0, "0") & "</text>"
			    & "<text x='16' y='76' font-size='11.5' fill='#667284'>" & "of " & [Divisions In Play] & " divisions with leavers in either year" & "</text>"
			    & "<line x1='16' y1='88' x2='320' y2='88' stroke='#E3E7EF'/>"
			    & "<text x='16' y='107' font-size='11.5' fill='#4A5768'>" & "Most up &#183; " & LEFT(MAXX(UpRow, 'Employee'[Division]), 24) & "</text><text x='320' y='107' font-size='11.5' font-weight='600' text-anchor='end' fill='" & IF(UpValue > 0, "#B3261E", "#1E7A4C") & "'>" & IF(UpValue < 0, "&#8722;", "+") & FORMAT(ABS(UpValue), "#,0") & "</text>"
			    & "<text x='16' y='127' font-size='11.5' fill='#4A5768'>" & "Most down &#183; " & LEFT(MAXX(DownRow, 'Employee'[Division]), 24) & "</text><text x='320' y='127' font-size='11.5' font-weight='600' text-anchor='end' fill='" & IF(DownValue > 0, "#B3261E", "#1E7A4C") & "'>" & IF(DownValue < 0, "&#8722;", "+") & FORMAT(ABS(DownValue), "#,0") & "</text>"
			    & Bars
			    & "</svg>"
			VAR NoComparison = "<svg xmlns='http://www.w3.org/2000/svg' width='336' height='140' viewBox='0 0 336 140' font-family='Segoe UI, sans-serif'><rect x='0.5' y='0.5' width='335' height='139' rx='4' fill='#FFFFFF' stroke='#E3E7EF'/><text x='16' y='24' font-size='11' font-weight='700' fill='#667284'>DIVISIONS WITH MORE LEAVERS</text><text x='16' y='64' font-size='13' fill='#4A5768'>Nothing to compare with for this year.</text></svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(IF([YoY Comparison Available], Svg, NoComparison), "%", "%25"), "#", "%23")
		dataCategory: ImageUrl
		lineageTag: dce2a950-9838-55bb-a218-fa15ee2fef86

	column Placeholder
		dataType: string
		isHidden
		lineageTag: b1600ac1-28fe-57b8-b76c-1719e6e6a97b
		summarizeBy: none
		sourceColumn: [Placeholder]

	partition 'YoY Metrics' = calculated
		mode: import
		source = ROW("Placeholder", "")
